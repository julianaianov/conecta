{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/app/*.test.mjs src/lib/seo/*.test.mjs src/lib/server/*.test.mjs src/app/*.test.mjs scripts/*.test.mjs",
    "test:services": "npm --prefix services/auth-service test && npm --prefix services/user-service test && npm --prefix services/post-service test",
    "seo:audit": "node scripts/audit-public-seo.mjs",
    "seed": "bash scripts/seed-recreio.sh",
    "seed:recreio": "bash scripts/seed-recreio.sh"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

# Ambiente: local, homologation ou production.
NEXT_PUBLIC_RUNTIME_ENV=local

# Gateway local; deixe vazio quando o catálogo de demonstração for suficiente.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Serviços Node (docker compose). Obrigatório: sem ele, ou com valor fraco
# (menos de 32 caracteres ou de exemplo), os serviços não sobem.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# UUIDs (auth_db.users.id) das contas da operação que leem /admin-snapshot,
# separados por vírgula. Vazio: ninguém acessa as rotas administrativas.
DM_OPERATION_USER_IDS=
# Controle só de interface do /admin (a checagem real é DM_OPERATION_USER_IDS).
NEXT_PUBLIC_ADMIN_EMAILS=

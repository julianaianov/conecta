# Ambiente: local, homologation ou production.
NEXT_PUBLIC_RUNTIME_ENV=local

# Gateway local das chamadas do navegador. Sem API, a interface fica sem dados:
# não existe catálogo de demonstração.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Endpoints internos do servidor Next.js para o SSR das páginas públicas (só
# server-side, nunca em NEXT_PUBLIC_*). No Compose de produção:
# http://post-service:3003 e http://user-service:3002.
# DM_INTERNAL_POST_API_URL=http://localhost:3003
# DM_INTERNAL_USER_API_URL=http://localhost:3002

# Serviços Node (docker compose). Obrigatório: sem ele, ou com valor fraco
# (menos de 32 caracteres ou de exemplo), os serviços não sobem.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# UUIDs (auth_db.users.id) das contas da operação que leem /admin-snapshot,
# separados por vírgula. Vazio: ninguém acessa as rotas administrativas.
DM_OPERATION_USER_IDS=
# Controle só de interface do /admin (a checagem real é DM_OPERATION_USER_IDS).
NEXT_PUBLIC_ADMIN_EMAILS=

# Uploads (T08): bucket S3 privado do ambiente. Vazio: as rotas de upload dos
# serviços respondem 503 `uploads_unavailable`. Na AWS vêm do SSM
# (uploads_bucket/uploads_region) e a credencial é o instance profile; no
# Compose local, use um bucket de desenvolvimento com credenciais temporárias.
DM_UPLOADS_BUCKET=
DM_UPLOADS_REGION=us-east-2
